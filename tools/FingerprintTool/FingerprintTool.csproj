<Project Sdk="Microsoft.NET.Sdk">
  <!-- Prints the IL fingerprint of Terraria.Collision.TileCollision for a given tModLoader.dll. See README.md for usage. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../IlFingerprint.cs" />
  </ItemGroup>
</Project>
